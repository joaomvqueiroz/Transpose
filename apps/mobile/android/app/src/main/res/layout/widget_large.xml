<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@mipmap/ic_launcher"
            android:contentDescription="Transpono" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="9dp">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Transpono" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#A8A9B0" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/w_loop" android:layout_width="100dp" android:layout_height="35dp"
            android:gravity="center" android:text="A–B: não marcado" android:textColor="#FFFFFF"
            android:textSize="10sp" android:background="@drawable/widget_inner" android:maxLines="2"
            android:contentDescription="Abrir trecho A–B" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="39dp" android:layout_marginTop="9dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_inner">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:paddingStart="11dp" android:text="TOM ATUAL"
            android:textColor="#A8A9B0" android:textSize="10sp" />
        <TextView android:id="@+id/w_pitch_minus" android:layout_width="32dp" android:layout_height="match_parent"
            android:gravity="center" android:text="−" android:textColor="#FFFFFF" android:textSize="20sp"
            android:contentDescription="Diminuir o tom" />
        <TextView android:id="@+id/w_pitch" android:layout_width="55dp" android:layout_height="match_parent"
            android:gravity="center" android:text="0 st" android:textColor="#FFFFFF" android:textSize="12sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/w_pitch_plus" android:layout_width="32dp" android:layout_height="match_parent"
            android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="20sp"
            android:contentDescription="Aumentar o tom" />
    </LinearLayout>
    <TextView android:id="@+id/w_chord" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginVertical="9dp" android:padding="12dp"
        android:gravity="center_vertical" android:text="Abra a cifra no app" android:textColor="#FFFFFF"
        android:textSize="13sp" android:maxLines="3" android:ellipsize="end"
        android:background="@drawable/widget_inner" android:contentDescription="Abrir cifra" />
    <ProgressBar android:id="@+id/w_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:max="100"
        android:progressTint="#FFFFFF" android:progressBackgroundTint="#414248" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_position" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#A8A9B0" android:textSize="9sp" />
        <TextView android:id="@+id/w_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#A8A9B0" android:textSize="9sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="39dp" android:orientation="horizontal"
        android:gravity="center" android:layout_marginTop="4dp">
        <TextView android:id="@+id/w_back" android:layout_width="44dp" android:layout_height="36dp"
            android:gravity="center" android:text="↶10" android:textColor="#FFFFFF" android:textSize="11sp"
            android:background="@drawable/widget_button" android:contentDescription="Voltar dez segundos" />
        <TextView android:id="@+id/w_play" android:layout_width="52dp" android:layout_height="39dp"
            android:layout_marginHorizontal="13dp" android:gravity="center" android:text="▶" android:textColor="#FFFFFF"
            android:textSize="18sp" android:background="@drawable/widget_button" android:contentDescription="Abrir e reproduzir" />
        <TextView android:id="@+id/w_forward" android:layout_width="44dp" android:layout_height="36dp"
            android:gravity="center" android:text="10↷" android:textColor="#FFFFFF" android:textSize="11sp"
            android:background="@drawable/widget_button" android:contentDescription="Avançar dez segundos" />
    </LinearLayout>
</LinearLayout>
