<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wn_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp"
    android:background="@drawable/widget_flat_bg">
    <ImageView android:id="@+id/wn_art" android:layout_width="56dp" android:layout_height="56dp"
        android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" android:contentDescription="Capa" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/wn_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Transpono" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/wn_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#B3B3B3" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@+id/wn_back" android:layout_width="38dp" android:layout_height="38dp" android:padding="7dp"
        android:src="@drawable/widget_ic_back" android:contentDescription="Voltar dez segundos" />
    <ImageView android:id="@+id/wn_play" android:layout_width="44dp" android:layout_height="44dp" android:padding="6dp"
        android:src="@drawable/widget_ic_play" android:contentDescription="Reproduzir ou pausar" />
    <ImageView android:id="@+id/wn_forward" android:layout_width="38dp" android:layout_height="38dp" android:padding="7dp"
        android:src="@drawable/widget_ic_forward" android:contentDescription="Avançar dez segundos" />
</LinearLayout>
