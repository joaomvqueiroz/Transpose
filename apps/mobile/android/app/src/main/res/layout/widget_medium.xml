<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@mipmap/ic_launcher"
            android:contentDescription="Transpono" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Transpono" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#A8A9B0" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="112dp" android:layout_height="38dp" android:orientation="horizontal"
            android:gravity="center" android:background="@drawable/widget_inner">
            <TextView android:id="@+id/w_pitch_minus" android:layout_width="27dp" android:layout_height="match_parent"
                android:gravity="center" android:text="−" android:textColor="#FFFFFF" android:textSize="19sp"
                android:contentDescription="Diminuir o tom" />
            <TextView android:id="@+id/w_pitch" android:layout_width="55dp" android:layout_height="match_parent"
                android:gravity="center" android:text="0 st" android:textColor="#FFFFFF" android:textSize="11sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/w_pitch_plus" android:layout_width="27dp" android:layout_height="match_parent"
                android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="19sp"
                android:contentDescription="Aumentar o tom" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/w_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:max="100"
        android:progressTint="#FFFFFF" android:progressBackgroundTint="#414248" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_position" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#A8A9B0" android:textSize="9sp" />
        <TextView android:id="@+id/w_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#A8A9B0" android:textSize="9sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal"
        android:gravity="center" android:layout_marginTop="3dp">
        <TextView android:id="@+id/w_back" android:layout_width="42dp" android:layout_height="32dp"
            android:gravity="center" android:text="↶10" android:textColor="#FFFFFF" android:textSize="11sp"
            android:background="@drawable/widget_button" android:contentDescription="Voltar dez segundos" />
        <TextView android:id="@+id/w_play" android:layout_width="48dp" android:layout_height="34dp"
            android:layout_marginHorizontal="10dp" android:gravity="center" android:text="▶" android:textColor="#FFFFFF"
            android:textSize="17sp" android:background="@drawable/widget_button" android:contentDescription="Abrir e reproduzir" />
        <TextView android:id="@+id/w_forward" android:layout_width="42dp" android:layout_height="32dp"
            android:gravity="center" android:text="10↷" android:textColor="#FFFFFF" android:textSize="11sp"
            android:background="@drawable/widget_button" android:contentDescription="Avançar dez segundos" />
    </LinearLayout>
</LinearLayout>
