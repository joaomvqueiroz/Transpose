{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": { "id": "transpono-gecko@transpono.app" }
  },
  "name": "Transpono Gecko bridge",
  "version": "1.0",
  "description": "Built-in: lets the Transpono app run its page-local practice scripts on YouTube. No media is captured, fetched or exported.",
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "https://*.youtube.com/*"
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'self'"
}
