{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "transpono-gecko@transpono.app"
    }
  },
  "name": "Transpono Gecko bridge",
  "version": "1.5",
  "description": "Built-in: lets the Transpono app run its page-local practice scripts on YouTube and SoundCloud, read the song title on Spotify and read chord sheets on Cifras.com.br. Can also copy the user’s own Google and Spotify sign-ins from Safari’s engine into this engine (cookies API; Google, YouTube and Spotify only). No media is captured, fetched or exported.",
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://open.spotify.com/*",
        "https://soundcloud.com/*",
        "https://*.soundcloud.com/*",
        "https://cifras.com.br/*",
        "https://www.cifras.com.br/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "https://*.youtube.com/*",
    "https://open.spotify.com/*",
    "https://soundcloud.com/*",
    "https://*.soundcloud.com/*",
    "https://cifras.com.br/*",
    "https://www.cifras.com.br/*",
    "cookies",
    "https://*.google.com/*",
    "https://*.spotify.com/*",
    "https://*.google.pt/*"
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'self'",
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
