{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": { "id": "transpono-gecko@transpono.app" }
  },
  "name": "Transpono Gecko bridge",
  "version": "1.3",
  "description": "Built-in: lets the Transpono app run its page-local practice scripts on YouTube and SoundCloud, read the song title on Spotify and read chord sheets on Cifras.com.br. No media is captured, fetched or exported.",
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://open.spotify.com/*",
        "https://soundcloud.com/*",
        "https://*.soundcloud.com/*",
        "https://cifras.com.br/*",
        "https://www.cifras.com.br/*"
      ],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "https://*.youtube.com/*",
    "https://open.spotify.com/*",
    "https://soundcloud.com/*",
    "https://*.soundcloud.com/*",
    "https://cifras.com.br/*",
    "https://www.cifras.com.br/*"
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'self'"
}
